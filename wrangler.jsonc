{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storeherald",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // How often Google Play, and App Store Connect for the options that need asc.appId, are polled. Remove it if you use neither.
  "triggers": { "crons": ["*/15 * * * *"] },
  // What the pollers have seen. Wrangler creates the namespace on the first deploy.
  "kv_namespaces": [{ "binding": "STATE" }],
  "observability": { "enabled": true }
}
