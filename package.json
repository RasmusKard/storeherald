{
  "name": "storeherald",
  "version": "2.2.0",
  "description": "A Cloudflare Worker that posts Expo release events from EAS, App Store Connect and Google Play to Slack, Discord and Teams",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "check": "tsc && npm run gen:defaults -- --check && npm run docs",
    "start": "wrangler dev",
    "gen:defaults": "tsdoc-defaults",
    "docs": "typedoc",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsdoc-defaults": "^0.1.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "wrangler": "^4.156.2"
  }
}
